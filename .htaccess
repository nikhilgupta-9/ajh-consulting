# =====================================================
#  AJH Consulting - Root .htaccess
# =====================================================

# Prevent directory listing
Options -Indexes

# Disable server signature
ServerSignature Off

RewriteEngine On

# ---- Block access to sensitive files ----
<FilesMatch "^(\.env(\.example)?|composer\.(json|lock)|\.gitignore|README\.md|database\.sql|schema\.sql)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|md|lock)$">
    Require all denied
</FilesMatch>

# Block dotfiles (.git, .env, etc.)
RewriteCond %{SCRIPT_FILENAME} -d [OR]
RewriteCond %{SCRIPT_FILENAME} -f
RewriteRule "(^|/)\." - [F]

# ---- Force HTTPS in production (uncomment on live server) ----
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- Aliases matching client architecture diagram ----
RewriteRule ^nz/accounting-firms/?$ nz/accounting-firm/ [NC,L]
RewriteRule ^nz/accounting-firms/(.*)$ nz/accounting-firm/$1 [NC,L]
RewriteRule ^au/accounting-firms/?$ au/accounting-firm/ [NC,L]
RewriteRule ^au/accounting-firms/(.*)$ au/accounting-firm/$1 [NC,L]

RewriteRule ^about/?$ about-us.php [NC,L]
RewriteRule ^how-we-work/?$ how-we-work.php [NC,L]
RewriteRule ^our-people/?$ our-peoples.php [NC,L]
RewriteRule ^insights/?$ insight-resources.php [NC,L]
RewriteRule ^contact/?$ contactus.php [NC,L]

# ---- Remove .php extension from URLs ----
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# ---- Redirect .php URLs to extension-less URLs ----
# GET only: a 301 on a POST request gets replayed as GET by browsers/curl,
# which would silently drop the submitted form data (login, contact, etc.).
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} /([^.]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# ---- Custom error pages ----
ErrorDocument 404 /404.php

# ---- Security headers ----
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/x-javascript text/javascript application/json
</IfModule>

# ---- Browser caching for static assets ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
