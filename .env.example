########################################
# get-accountant - Environment Config
# Copy this file to ".env" and fill in
# your real values. Never commit ".env".
########################################

APP_NAME="get-accountant"
APP_URL=http://localhost/ajh-accounting
APP_ENV=local
APP_DEBUG=true

# ---- Database (MySQL / XAMPP) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=get_accountant_nz
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---- Admin panel default super-admin ----
# Used only by database/schema.sql seed instructions.
ADMIN_EMAIL=admin@get-accountant.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ---- Mail (for contact / appointment notifications) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@get-accountant.com
MAIL_FROM_NAME="get-accountant"
MAIL_TO=admin@get-accountant.com

# ---- Security ----
SESSION_NAME=getaccountant_admin_session
CSRF_SECRET=change_this_to_a_long_random_string

# ---- Business contact info shown on the public site ----
BUSINESS_EMAIL=info@get-accountant.com
BUSINESS_PHONE=+64 00 000 0000
BUSINESS_ADDRESS=New Zealand
