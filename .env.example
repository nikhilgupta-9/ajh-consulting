########################################
# AJH Consulting - Environment Config
# Copy this file to ".env" and fill in
# your real values. Never commit ".env".
########################################

APP_NAME="AJH Consulting"
APP_URL=http://localhost/ajh-accounting
APP_ENV=local
APP_DEBUG=true

# ---- Database (MySQL / XAMPP) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ajh_consulting
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---- Admin panel default super-admin ----
# Used only by database/schema.sql seed instructions.
ADMIN_EMAIL=admin@ajhconsulting.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ---- Mail (for contact / appointment notifications) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ajhconsulting.com
MAIL_FROM_NAME="AJH Consulting"
MAIL_TO=admin@ajhconsulting.com

# ---- Security ----
SESSION_NAME=ajh_admin_session
CSRF_SECRET=change_this_to_a_long_random_string

# ---- Business contact info shown on the public site ----
BUSINESS_EMAIL=info@ajhconsulting.com
BUSINESS_PHONE=+91 98765 43210
BUSINESS_ADDRESS=123 Business Avenue, New Delhi, India
